t \n\n\tcolor = '#27364B'\n\tsize = '33px'\n\tbold = 'true' \n\ttype = 'variable'\n\n\n\n\n\n\n\n\t  value = '${proteinTarget} g'\n>\n</text>\n\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t<text \n\n\tcolor = '#64748B'\n\tsize = '15px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Daily target'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '15px'\n\tbgColor = '#FFF8E5'\n\n\t\twidth = '50%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t<text \n\n\tcolor = '#9A741C'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = '\uD83C\uDF3E Carbohydrates'\n>\n</text>\n\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t<text \n\n\tcolor = '#27364B'\n\tsize = '33px'\n\tbold = 'true' \n\ttype = 'variable'\n\n\n\n\n\n\n\n\t  value = '${carbTarget} g'\n>\n</text>\n\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t<text \n\n\tcolor = '#64748B'\n\tsize = '15px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Daily target'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n\t\tpadding = '15px'\n\tbgColor = '#E8F7F2'\n\n\t\twidth = '50%'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t<text \n\n\tcolor = '#21836A'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = '\uD83E\uDD51 Daily Fat'\n>\n</text>\n\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t<text \n\n\tcolor = '#27364B'\n\tsize = '33px'\n\tbold = 'true' \n\ttype = 'variable'\n\n\n\n\n\n\n\n\t  value = '${fatTarget} g'\n>\n</text>\n\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t<text \n\n\tcolor = '#64748B'\n\tsize = '15px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Daily target'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\n\t\twidth = '100%'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#000000'\n\tsize = '24px'\n\tbold = 'true' \n\tfontFamily = 'roboto-regular' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n\t  value = 'Your AI Diet Assistant'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '0px'\n\tpaddingLeft = '17px'\n\tpaddingRight = '17px'\n\tpaddingBottom = '17px'\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#000000'\n\tsize = '20px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n\t  value = 'Hello! I&apos;m your personal AI Diet Assistant. I can recommend meals based on your health profile, dietary preferences, allergies and fitness goals.  Let&apos;s find something healthy and delicious for you!'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '0px'\n\tpaddingLeft = '17px'\n\tpaddingRight = '17px'\n\tpaddingBottom = '17px'\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<button \n\t\tmargin = '0px'\n\tpaddingTop = '12px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '12px'\n\n    action = 'ExecuteFunction'\n\t\t\texecuteWorkflow = 'afterConfirmation'\n\n\t\tfunctionName = 'validate_gemini_response'  \n\tcolor = '#FFFFFF'\n\tsize = '16px'\n    borderColor = '#FFFFFF'\n    borderWidth = '0px'\n\ttext ='Recommend Meals for Me'\n\t\tbgColor = 'theme'\n\t\tcornerRadius = '6px' \n\t\tsuccessMsg = 'Your personalized meal plan has been generated successfully and submitted for admin review!'\n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<panel elementName='Panel 4'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#000000'\n\tsize = '20px'\n\tbold = 'true' \n\tfontFamily = 'roboto-regular' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n\t  value = 'Your Recommended Meal Plan'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='50%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#000000'\n\tsize = '20px'\n\tbold = 'true' \n\tfontFamily = 'roboto-regular' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n\t  value = 'My Meal Plans'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<report \n\telementName='Report 1'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Meal_Plan_Details_Report'\n\t\tcriteriaString = 'User.Email == zoho.loginuserid'\n\t\n\t\tiszreport = 'false'\n\t\t\t\t\tzc_Footer = 'false'\n\t\t\t\t\tzc_AddRec = 'false'\n\t\t\t\t\tzc_EditRec = 'false'\n\t\t\t\t\tzc_Print = 'false'\n\t\t\t\t\tzc_Export = 'false'\n\t\t\t\t\tzc_DelRec = 'false'\n\t\t\t\t\tzc_DuplRec = 'false'\n\t\t\t\t\tzc_Search = 'false'\n\t\t\t\t\tzc_EditBulkRec = 'false'\n\t\t\t\t\tzc_BulkDelete = 'false'\n\t\t\t\t\tzc_BulkDuplicate = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column><column\n   \t\t width='50%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'All_Meal_Plans'\n\t\n\t\tiszreport = 'false'\n\t\t\t\t\tzc_AddRec = 'false'\n\t\t\t\t\tzc_EditRec = 'false'\n\t\t\t\t\tzc_Print = 'false'\n\t\t\t\t\tzc_Export = 'false'\n\t\t\t\t\tzc_DelRec = 'false'\n\t\t\t\t\tzc_DuplRec = 'false'\n\t\t\t\t\tzc_Search = 'false'\n\t\t\t\t\tzc_EditBulkRec = 'false'\n\t\t\t\t\tzc_BulkDelete = 'false'\n\t\t\t\t\tzc_BulkDuplicate = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row>\n</column>\n</row>\n</layout>\n</zml>"
			script
			{
				loggedInEmail = zoho.loginuserid;
				userRecord = Users[Email == loggedInEmail];
				if(userRecord.count() > 0)
				{
					userId = userRecord.ID;
					input.logged_in_user_id = userId;
					// Total meal plans
					myPlans = Meal_Plans[User == userId];
					input.my_meal_plan_count = myPlans.count();
					// Pending review
					pendingPlans = Meal_Plans[User == userId && Plan_Status == "Pending review"];
					input.pending_review_count = pendingPlans.count();
					// Active plans
					activePlans = Meal_Plans[User == userId && Plan_Status == "Active"];
					input.active_plan_count = activePlans.count();
					// Fitness goals
					fitnessGoals = Fitness_Goals[User == userId];
					input.fitness_goal_count = fitnessGoals.count();
					// Latest meal plan nutrition targets
					latestPlan = Meal_Plans[User == userId] sort by Added_Time desc range from 0 to 0;
					input.calorieTarget = 0;
					input.proteinTarget = 0;
					input.carbTarget = 0;
					input.fatTarget = 0;
					latest_meal_plan_record_id = 0;
					if(latestPlan.count() > 0)
					{
						input.calorieTarget = ifnull(latestPlan.Daily_Calorie_Target_kcal,0).toNumber();
						input.proteinTarget = ifnull(latestPlan.Daily_Protein_Target_grams,0);
						input.carbTarget = ifnull(latestPlan.Daily_Carbohydrate_Target_grams,0);
						input.fatTarget = ifnull(latestPlan.Daily_Fat_Target_grams,0);
						latest_meal_plan_record_id = latestPlan.ID;
					}
				}
				else
				{
					input.my_meal_plan_count = 0;
					input.pending_review_count = 0;
					input.active_plan_count = 0;
					input.fitness_goal_count = 0;
				}
			}
		}
	}


		 functions
		 {
			 Deluge
			 {
				 string generate_ai_meal_plan()
                 {
                 	// STEP 1: Identify logged-in user
                 	profile = thisapp.get_logged_in_user_profile();
                 	if(profile.get("found") != true)
                 	{
                 		return "Error: User profile not found.";
                 	}
                 	userId = profile.get("user_id");
                 	// STEP 2: Fetch latest user profiles
                 	dietaryRecord = Dietary_Preferences[User == userId] sort by Created_Date desc range from 0 to 0;
                 	healthRecord = Health_Profile[User == userId] sort by Created_Date desc range from 0 to 0;
                 	fitnessRecord = Fitness_Goals[User == userId] sort by Created_Date desc range from 0 to 0;
                 	if(dietaryRecord.count() == 0)
                 	{
                 		return "Please complete your Dietary Preferences form.";
                 	}
                 	if(healthRecord.count() == 0)
                 	{
                 		return "Please complete your Health Profile form.";
                 	}
                 	if(fitnessRecord.count() == 0)
                 	{
                 		return "Please complete your Fitness Goals form.";
                 	}
                 	// STEP 3: Prepare dietary preferences
                 	dietaryData = Map();
                 	for each  d in dietaryRecord
                 	{
                 		dietaryData.put("diet_type",d.Diet_Type);
                 		dietaryData.put("dietary_restrictions",d.Dietary_Restrictions);
                 		dietaryData.put("preferred_meals_per_day",d.Preferred_Meals_Per_Day);
                 		dietaryData.put("preferred_staple_foods",d.Preferred_Staple_Foods);
                 		dietaryData.put("preferred_breakfast_foods",d.Preferred_Breakfast_Foods);
                 		dietaryData.put("preferred_lunch_foods",d.Preferred_Lunch_Foods);
                 		dietaryData.put("preferred_dinner_foods",d.Preferred_Dinner_Foods);
                 		dietaryData.put("preferred_food_style",d.Preferred_Food_Style);
                 		dietaryData.put("non_vegetarian_preferences",d.Non_Vegetarian_Food_Preferences);
                 		dietaryData.put("disliked_foods",d.Disliked_Foods);
                 		dietaryData.put("spice_preference",d.Spice_Preference);
                 		dietaryData.put("daily_calorie_goal",d.Daily_Calorie_Goal);
                 		dietaryData.put("additional_preferences",d.Additional_Food_Preferences);
                 	}
                 	// STEP 4: Prepare health information
                 	healthData = Map();
                 	for each  h in healthRecord
                 	{
                 		healthData.put("has_food_allergies",h.Has_Food_Allergies);
                 		healthData.put("allergen_categories",h.Allergen_Categories);
                 		healthData.put("specific_allergens",h.Specific_Allergens);
                 		healthData.put("reaction_symptoms",h.Reaction_Symptoms);
                 		healthData.put("allergy_severity",h.Allergy_Severity);
                 		healthData.put("diagnosis_status",h.Diagnosis_Status);
                 		healthData.put("dietary_considerations",h.Dietary_Considerations);
                 		healthData.put("has_health_conditions",h.Has_Health_Conditions);
                 		healthData.put("condition_categories",h.Condition_Categories);
                 		healthData.put("specific_conditions",h.Specific_Conditions);
                 		healthData.put("additional_notes",h.Additional_Notes);
                 	}
                 	// STEP 5: Prepare fitness goals
                 	fitnessData = Map();
                 	for each  f in fitnessRecord
                 	{
                 		fitnessData.put("primary_fitness_goal",f.Primary_Fitness_Goal);
                 		fitnessData.put("current_fitness_level",f.Current_Fitness_Level);
                 		fitnessData.put("target_weight_kg",f.Target_Weight_kg);
                 		fitnessData.put("daily_activity_duration_minutes",f.Daily_Activity_Duration_Minutes);
                 		fitnessData.put("preferred_physical_activities",f.Preferred_Physical_Activities);
                 		fitnessData.put("motivation_goal_description",f.Motivation_Goal_Description);
                 		fitnessData.put("target_achievement_date",f.Target_Achievement_Date);
                 		fitnessData.put("additional_notes",f.Additional_Notes);
                 	}
                 	// STEP 6: Fetch existing meals
                 	mealCatalog = List();
                 	for each  mealRecord in Meals[ID != 0]
                 	{
                 		meal = Map();
                 		meal.put("meal_id",mealRecord.ID);
                 		meal.put("meal_name",mealRecord.Meal_Name);
                 		meal.put("meal_category",mealRecord.Meal_Category);
                 		meal.put("food_type",mealRecord.Food_Type);
                 		meal.put("calories",mealRecord.Calories);
                 		meal.put("protein",mealRecord.Protein);
                 		meal.put("carbohydrates",mealRecord.Carbohydrates);
                 		meal.put("fibre",mealRecord.Fibre);
                 		meal.put("fat",mealRecord.Fat);
                 		meal.put("contains_allergens",mealRecord.Contains_Allergens);
                 		meal.put("cuisine",mealRecord.Cuisine);
                 		meal.put("main_ingredients",mealRecord.Main_Ingredients);
                 		meal.put("serving_size",mealRecord.Serving_Size);
                 		meal.put("recipe_instructions",mealRecord.Recipe_Instructions);
                 		mealCatalog.add(meal);
                 	}
                 	if(mealCatalog.size() == 0)
                 	{
                 		return "No meals found in the Meals form.";
                 	}
                 	// STEP 7: Prepare Gemini prompt
                 	prompt = "Create a personalized meal recommendation using ONLY the supplied meal catalogue. " + "Never invent meal names or IDs. " + "Avoid all known allergens and dietary restrictions. " + "Respect the user's diet type, preferences and fitness goal. " + "If no meal is safe, return an empty recommended_meals array. " + "Return valid JSON only with plan_explanation and recommended_meals. " + "\nDiet type: " + ifnull(dietaryData.get("diet_type"),"Not provided") + "\nRestrictions: " + ifnull(dietaryData.get("dietary_restrictions"),"Not provided") + "\nDisliked foods: " + ifnull(dietaryData.get("disliked_foods"),"Not provided") + "\nCalorie goal: " + ifnull(dietaryData.get("daily_calorie_goal"),"Not provided") + "\nAllergies: " + ifnull(healthData.get("specific_allergens"),"Not provided") + "\nAllergen categories: " + ifnull(healthData.get("allergen_categories"),"Not provided") + "\nHealth conditions: " + ifnull(healthData.get("specific_conditions"),"Not provided") + "\nFitness goal: " + ifnull(fitnessData.get("primary_fitness_goal"),"Not provided") + "\nAvailable meals: " + mealCatalog.toString();
                 	// STEP 8: Build Gemini API request
                 	payload = Map();
                 	contents = List();
                 	content = Map();
                 	parts = List();
                 	part = Map();
                 	part.put("text",prompt);
                 	parts.add(part);
                 	content.put("parts",parts);
                 	content.put("role","user");
                 	contents.add(content);
                 	payload.put("contents",contents);
                 	// STEP 9: Configure Gemini response
                 	generationConfig = Map();
                 	generationConfig.put("maxOutputTokens",2048);
                 	generationConfig.put("responseMimeType","application/json");
                 	thinkingConfig = Map();
                 	thinkingConfig.put("thinkingLevel","LOW");
                 	generationConfig.put("thinkingConfig",thinkingConfig);
                 	payload.put("generationConfig",generationConfig);
                 	// STEP 10: Send request to Gemini
                 	headers = Map();
                 	headers.put("Content-Type","application/json");
                 	response = invokeurl
                 	[
                 		url :"https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent"
                 		type :POST
                 		body:payload.toString()
                 		headers:headers
                 		detailed:true
                 		connection:"gemini_admin_connection"
                 	];
                 	// STEP 11: Return Gemini response for validation
                 	// STEP 11: Validate Gemini API response
                 	// Check HTTP response status
                 	responseCode = response.get("responseCode");
                 	if(responseCode != 200)
                 	{
                 		return "Error: Gemini API request failed. Response: " + response.toString();
                 	}
                 	// Extract response body
                 	responseBody = response.get("responseText");
                 	if(responseBody == null)
                 	{
                 		return "Error: Gemini returned an empty response.";
                 	}
                 	// Extract candidates
                 	candidates = responseBody.get("candidates");
                 	if(candidates == null || candidates.size() == 0)
                 	{
                 		return "Error: Gemini did not generate any recommendations.";
                 	}
                 	// Get the first candidate
                 	candidate = candidates.get(0);
                 	// Check whether generation completed successfully
                 	finishReason = candidate.get("finishReason");
                 	if(finishReason != "STOP")
                 	{
                 		return "Error: Gemini response is incomplete. Finish reason: " + finishReason;
                 	}
                 	// Extract generated JSON text
                 	contentData = candidate.get("content");
                 	partsData = contentData.get("parts");
                 	if(partsData == null || partsData.size() == 0)
                 	{
                 		return "Error: Gemini returned no recommendation content.";
                 	}
                 	firstPart = partsData.get(0);
                 	generatedText = firstPart.get("text");
                 	if(generatedText == null || generatedText == "")
                 	{
                 		return "Error: Gemini returned empty recommendation text.";
                 	}
                 	// Parse JSON response
                 	parsedResponse = generatedText.toMap();
                 	// Verify required JSON fields
                 	if(parsedResponse.get("plan_explanation") == null || parsedResponse.get("recommended_meals") == null)
                 	{
                 		return "Error: Gemini response is missing required fields.";
                 	}
                 	// Return parsed JSON for the next validation stage
                 	return response.toString();
                 }
				 map get_logged_in_user_profile()
                 {
                 	loggedInEmail = zoho.loginuserid;
                 	result = Map();
                 	result.put("login_email",loggedInEmail);
                 	userRecord = Users[Email == loggedInEmail];
                 	if(userRecord.count() > 0)
                 	{
                 		result.put("found",true);
                 		result.put("user_id",userRecord.ID);
                 		result.put("user_name",userRecord.User_Name);
                 	}
                 	else
                 	{
                 		result.put("found",false);
                 		result.put("message","No matching user profile found.");
                 	}
                 	return result;
                 }
				 int get_my_meal_plan_count()
                 {
                 	profile = thisapp.get_logged_in_user_profile();
                 	if(profile.get("found") == true)
                 	{
                 		userId = profile.get("user_id");
                 		myPlans = Meal_Plans[User == userId];
                 		return myPlans.count();
                 	}
                 	return 0;
                 }
				 string review_meal_plan(int planID, string decision, string comments)
                 {
                 	// STEP 1: Identify logged-in user
                 	profile = thisapp.get_logged_in_user_profile();
                 	if(profile.get("found") != true)
                 	{
                 		return "Review Failed: User profile not found.";
                 	}
                 	userId = profile.get("user_id");
                 	// STEP 2: Verify administrator role
                 	adminRecord = Users[ID == userId];
                 	if(adminRecord.count() == 0)
                 	{
                 		return "Review Failed: User record not found.";
                 	}
                 	if(adminRecord.Role != "Admin")
                 	{
                 		return "Access Denied: Only administrators can review meal plans.";
                 	}
                 	// STEP 3: Validate decision
                 	if(decision != "Approved" && decision != "Rejected")
                 	{
                 		return "Review Failed: Invalid decision.";
                 	}
                 	// STEP 4: Find meal plan
                 	planRecord = Meal_Plans[ID == planID];
                 	if(planRecord.count() == 0)
                 	{
                 		return "Review Failed: Meal plan not found.";
                 	}
                 	// STEP 5: Check current status
                 	if(planRecord.Plan_Status != "Pending Review")
                 	{
                 		return "Review Failed: Only pending meal plans can be reviewed.";
                 	}
                 	// STEP 6: Update review details
                 	planRecord.Plan_Status=decision;
                 	planRecord.Admin_Comments=comments;
                 	planRecord.Reviewed_By=adminRecord.User_Name;
                 	planRecord.Review_Date=zoho.currenttime;
                 	// STEP 7: Return result
                 	return "Success: Meal plan " + decision + " successfully. Plan ID: " + planID;
                 }
				 string sync_user_to_crm(int userID)
                 {
                 	userRecord = Users[ID == userID];
                 	if(userRecord.count() == 0)
                 	{
                 		return "Error: User not found in Creator.";
                 	}
                 	if(ifnull(userRecord.Email,"") == "" || ifnull(userRecord.User_Name,"") == "")
                 	{
                 		return "Error: User name or email is missing.";
                 	}
                 	searchResponse = zoho.crm.v8.searchRecords("Contacts","(Email:equals:" + userRecord.Email + ")",1,200,Map(),"zoho_crm_connection");
                 	contactData = Map();
                 	contactData.put("Last_Name",userRecord.User_Name);
                 	contactData.put("Email",userRecord.Email);
                 	contactData.put("Phone",userRecord.Phone_Number);
                 	if(searchResponse.size() > 0)
                 	{
                 		crmContactID = searchResponse.get(0).get("id");
                 		updateResponse = zoho.crm.v8.updateRecord("Contacts",crmContactID.toLong(),contactData,Map(),"zoho_crm_connection");
                 		return "CRM Contact updated: " + updateResponse.toString();
                 	}
                 	else
                 	{
                 		createResponse = zoho.crm.v8.createRecord("Contacts",contactData,Map(),"zoho_crm_connection");
                 		return "CRM Contact creation response: " + createResponse.toString();
                 	}
                 }
				 string test_gemini_connection()
                 {
                 	payload = Map();
                 	contents = List();
                 	content = Map();
                 	parts = List();
                 	part = Map();
                 	part.put("text","Hello Gemini! Reply with: Gemini connection successful.");
                 	parts.add(part);
                 	content.put("parts",parts);
                 	content.put("role","user");
                 	contents.add(content);
                 	payload.put("contents",contents);
                 	headers = Map();
                 	headers.put("Content-Type","application/json");
                 	response = invokeurl
                 	[
                 		url :"https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent"
                 		type :POST
                 		body:payload.toString()
                 		headers:headers
                 		detailed:true
                 		connection:"gemini_admin_connection"
                 	];
                 	return response.toString();
                 }
				 string validate_gemini_response()
                 {
                 	// STEP 1: Identify logged-in user
                 	profile = thisapp.get_logged_in_user_profile();
                 	if(profile.get("found") != true)
                 	{
                 		return "Validation Failed: User profile not found.";
                 	}
                 	userId = profile.get("user_id");
                 	// STEP 2: Fetch latest health profile
                 	healthRecord = Health_Profile[User == userId] sort by Created_Date desc range from 0 to 0;
                 	if(healthRecord.count() == 0)
                 	{
                 		return "Validation Failed: Health Profile not found.";
                 	}
                 	userCategories = List();
                 	specificText = "";
                 	for each  h in healthRecord
                 	{
                 		userCategories = ifnull(h.Allergen_Categories,List());
                 		specificText = ifnull(h.Specific_Allergens,"").toLowerCase();
                 	}
                 	// STEP 3: Generate Gemini response
                 	geminiResult = thisapp.generate_ai_meal_plan();
                 	if(geminiResult == null || geminiResult == "")
                 	{
                 		return "Validation Failed: Empty Gemini response.";
                 	}
                 	// STEP 4: Parse outer API response
                 	responseMap = Map();
                 	try 
                 	{
                 		responseMap = geminiResult.toMap();
                 	}	catch (e)
                 	{
                 		return "Validation Failed: Invalid API response. " + geminiResult;
                 	}
                 	responseCode = responseMap.get("responseCode");
                 	if(responseCode == null || responseCode != 200)
                 	{
                 		return "Validation Failed: Gemini API returned an error.";
                 	}
                 	responseBody = responseMap.get("responseText");
                 	if(responseBody == null)
                 	{
                 		return "Validation Failed: Response body missing.";
                 	}
                 	// STEP 5: Check Gemini completion
                 	candidates = responseBody.get("candidates");
                 	if(candidates == null || candidates.size() == 0)
                 	{
                 		return "Validation Failed: No Gemini candidates.";
                 	}
                 	candidate = candidates.get(0);
                 	if(candidate.get("finishReason") != "STOP")
                 	{
                 		return "Validation Failed: Incomplete Gemini response.";
                 	}
                 	// STEP 6: Extract generated JSON
                 	parts = candidate.get("content").get("parts");
                 	if(parts == null || parts.size() == 0)
                 	{
                 		return "Validation Failed: Gemini text missing.";
                 	}
                 	generatedText = parts.get(0).get("text");
                 	mealPlan = Map();
                 	try 
                 	{
                 		mealPlan = generatedText.toMap();
                 	}	catch (e)
                 	{
                 		return "Validation Failed: Invalid meal plan JSON.";
                 	}
                 	if(mealPlan.get("plan_explanation") == null)
                 	{
                 		return "Validation Failed: Plan explanation missing.";
                 	}
                 	recommendedMeals = mealPlan.get("recommended_meals");
                 	if(recommendedMeals == null || recommendedMeals.size() == 0)
                 	{
                 		return "Validation Failed: No recommended meals.";
                 	}
                 	// STEP 7: Verify actual meal records
                 	validatedCount = 0;
                 	totalCalories = 0;
                 	totalProtein = 0;
                 	totalCarbohydrates = 0;
                 	totalFat = 0;
                 	for each  meal in recommendedMeals
                 	{
                 		mealId = meal.get("meal_id");
                 		if(mealId == null)
                 		{
                 			return "Validation Failed: Meal ID missing.";
                 		}
                 		actualMeal = Meals[ID == mealId.toLong()];
                 		if(actualMeal.count() == 0)
                 		{
                 			return "Validation Failed: Meal ID " + mealId + " does not exist.";
                 		}
                 		if(actualMeal.Availability_Status != "Available")
                 		{
                 			return "Validation Failed: " + actualMeal.Meal_Name + " is unavailable.";
                 		}
                 		// STEP 8: Get actual allergen values from Zoho
                 		mealAllergens = ifnull(actualMeal.Contains_Allergens,List());
                 		mealIngredients = ifnull(actualMeal.Main_Ingredients,"").toLowerCase();
                 		allergyConflict = false;
                 		// STEP 9: Match allergen categories
                 		for each  category in userCategories
                 		{
                 			if(category == "Peanuts / Groundnuts" && mealAllergens.contains("Peanuts"))
                 			{
                 				allergyConflict = true;
                 			}
                 			if(category == "Tree Nuts" && mealAllergens.contains("Tree Nuts"))
                 			{
                 				allergyConflict = true;
                 			}
                 			if(category == "Milk and Dairy Products" && mealAllergens.contains("Milk and Dairy"))
                 			{
                 				allergyConflict = true;
                 			}
                 			if(category == "Eggs" && mealAllergens.contains("Eggs"))
                 			{
                 				allergyConflict = true;
                 			}
                 			if(category == "Fish" && mealAllergens.contains("Fish"))
                 			{
                 				allergyConflict = true;
                 			}
                 			if(category == "Prawns and Shellfish" && mealAllergens.contains("Shellfish"))
                 			{
                 				allergyConflict = true;
                 			}
                 			if(category == "Soy" && mealAllergens.contains("Soy"))
                 			{
                 				allergyConflict = true;
                 			}
                 			if(category == "Wheat / Gluten" && mealAllergens.contains("Wheat / Gluten"))
                 			{
                 				allergyConflict = true;
                 			}
                 			if(category == "Sesame Seeds (Ellu)" && mealAllergens.contains("Sesame"))
                 			{
                 				allergyConflict = true;
                 			}
                 			if(category == "Coconut" && mealAllergens.contains("Coconut"))
                 			{
                 				allergyConflict = true;
                 			}
                 			if(category == "Mustard Seeds (Kadugu)" && mealAllergens.contains("Mustard"))
                 			{
                 				allergyConflict = true;
                 			}
                 			if(category == "Other" && mealAllergens.contains("Other"))
                 			{
                 				allergyConflict = true;
                 			}
                 			// Chickpeas and legumes: check actual ingredients
                 			if(category == "Chickpeas and Legumes")
                 			{
                 				if(mealIngredients.contains("chickpea") || mealIngredients.contains("legume") || mealIngredients.contains("lentil") || mealIngredients.contains("gram"))
                 				{
                 					allergyConflict = true;
                 				}
                 			}
                 		}
                 		// STEP 10: Match specific allergen names
                 		if(specificText.contains("peanut") || specificText.contains("groundnut"))
                 		{
                 			if(mealAllergens.contains("Peanuts"))
                 			{
                 				allergyConflict = true;
                 			}
                 		}
                 		if(specificText.contains("almond") || specificText.contains("cashew") || specificText.contains("walnut") || specificText.contains("pistachio"))
                 		{
                 			if(mealAllergens.contains("Tree Nuts"))
                 			{
                 				allergyConflict = true;
                 			}
                 		}
                 		if(specificText.contains("milk") || specificText.contains("dairy") || specificText.contains("lactose"))
                 		{
                 			if(mealAllergens.contains("Milk and Dairy"))
                 			{
                 				allergyConflict = true;
                 			}
                 		}
                 		if(specificText.contains("egg"))
                 		{
                 			if(mealAllergens.contains("Eggs"))
                 			{
                 				allergyConflict = true;
                 			}
                 		}
                 		if(specificText.contains("fish"))
                 		{
                 			if(mealAllergens.contains("Fish"))
                 			{
                 				allergyConflict = true;
                 			}
                 		}
                 		if(specificText.contains("prawn") || specificText.contains("shrimp") || specificText.contains("shellfish") || specificText.contains("crab") || specificText.contains("lobster"))
                 		{
                 			if(mealAllergens.contains("Shellfish"))
                 			{
                 				allergyConflict = true;
                 			}
                 		}
                 		if(specificText.contains("soy") || specificText.contains("soya"))
                 		{
                 			if(mealAllergens.contains("Soy"))
                 			{
                 				allergyConflict = true;
                 			}
                 		}
                 		if(specificText.contains("wheat") || specificText.contains("gluten"))
                 		{
                 			if(mealAllergens.contains("Wheat / Gluten"))
                 			{
                 				allergyConflict = true;
                 			}
                 		}
                 		if(specificText.contains("sesame") || specificText.contains("ellu"))
                 		{
                 			if(mealAllergens.contains("Sesame"))
                 			{
                 				allergyConflict = true;
                 			}
                 		}
                 		if(specificText.contains("coconut"))
                 		{
                 			if(mealAllergens.contains("Coconut"))
                 			{
                 				allergyConflict = true;
                 			}
                 		}
                 		if(specificText.contains("mustard") || specificText.contains("kadugu"))
                 		{
                 			if(mealAllergens.contains("Mustard"))
                 			{
                 				allergyConflict = true;
                 			}
                 		}
                 		// STEP 11: Reject conflicting meals
                 		if(allergyConflict == true)
                 		{
                 			return "Validation Failed: Allergy conflict detected in meal: " + actualMeal.Meal_Name;
                 		}
                 		validatedCount = validatedCount + 1;
                 		// Calculate nutrition using actual Zoho meal records
                 		totalCalories = totalCalories + ifnull(actualMeal.Calories,0);
                 		totalProtein = totalProtein + ifnull(actualMeal.Protein,0);
                 		totalCarbohydrates = totalCarbohydrates + ifnull(actualMeal.Carbohydrates,0);
                 		totalFat = totalFat + ifnull(actualMeal.Fat,0);
                 	}
                 	// STEP 12: Fetch latest user preferences
                 	dietaryRecord = Dietary_Preferences[User == userId] sort by Created_Date desc range from 0 to 0;
                 	fitnessRecord = Fitness_Goals[User == userId] sort by Created_Date desc range from 0 to 0;
                 	if(dietaryRecord.count() == 0 || fitnessRecord.count() == 0)
                 	{
                 		return "Validation Passed, but user preferences or fitness goals are missing.";
                 	}
                 	// STEP 13: Prepare plan dates
                 	startDate = zoho.currentdate;
                 	planDuration = 1;
                 	endDate = startDate.addDay(planDuration - 1);
                 	// STEP 14: Create parent Meal_Plans record
                 	planID = insert into Meal_Plans
                 	[
                 		Plan_Name="AI Personalized Meal Plan - " + startDate.toString()
                 		User=userId
                 		Plan_Description=mealPlan.get("plan_explanation")
                 		Plan_Type="AI Generated"
                 		Fitness_Goal=fitnessRecord.Primary_Fitness_Goal
                 		Start_Date=startDate
                 		End_Date=endDate
                 		Plan_Duration_Days=planDuration
                 		Daily_Calorie_Target_kcal=ifnull(dietaryRecord.Daily_Calorie_Goal,0)
                 		Daily_Protein_Target_grams=0
                 		Daily_Carbohydrate_Target_grams=0
                 		Daily_Fat_Target_grams=0
                 		Plan_Status="Pending Review"
                 		Created_Date=zoho.currenttime
                 		Added_User=zoho.loginuser
                 	];
                 	info Meal_Plans[ID == planID];
                 	info "NEW MEAL PLAN ID: " + planID;
                 	if(planID == null)
                 	{
                 		return "Validation Passed, but Meal Plan creation failed.";
                 	}
                 	// STEP 15: Create child Meal_Plan_Details records
                 	detailCount = 0;
                 	for each  meal in recommendedMeals
                 	{
                 		mealId = meal.get("meal_id").toLong();
                 		actualMeal = Meals[ID == mealId];
                 		detailID = insert into Meal_Plan_Details
                 		[
                 			Meal_Plan=planID
                 			Meals=mealId
                 			User=userId
                 			Scheduled_Date=startDate
                 			Day_Number=1
                 			Meal_Type=actualMeal.Meal_Category
                 			Serving_Quantity=1
                 			Added_User=zoho.loginuser
                 		];
                 		if(detailID != null)
                 		{
                 			detailCount = detailCount + 1;
                 		}
                 	}
                 	// STEP 16: Final result
                 	if(detailCount != validatedCount)
                 	{
                 		return "Meal Plan created, but only " + detailCount + " of " + validatedCount + " meal details were saved. Please review the records.";
                 	}
                 	return "SUCCESS! Meal Plan created successfully. Plan ID: " + planID + ". Validated meals saved: " + detailCount + ". Status: Pending Review.";
                 }
			 }
		 }


		workflow
		{
		form
		{
			Auto_Fill_Meal_Plan_Infor as "Auto Fill Meal Plan Information"
			{
				type =  form
				form = Meal_Plan_Details

				record event = on add or edit

				on user input of Meal_Plan
				{
					actions 
					{
						custom deluge script
						(
											if(input.Meal_Plan != null)
										{
											selectedPlan = Meal_Plans[ID == input.Meal_Plan];
											input.User = selectedPlan.User;
											input.Start_Date = selectedPlan.Start_Date;
											input.End_Date = selectedPlan.End_Date;
										}
						)
					}
				}

			}
			Auto_Assign_Logged_In_Use as "Auto Assign Logged In User"
			{
				type =  form
				form = Meal_Plans

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											loggedInEmail = zoho.loginuserid;
										userRecord = Users[Email == loggedInEmail];
										if(userRecord.count() > 0)
										{
											input.User = userRecord.ID;
										}
						)
					}
				}

			}
			Analyze_Food_Label_With_G as "Analyze_Food_Label_With_Gemini"
			{
				type =  form
				form = Food_Scanner

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											ocrText = ifnull(input.OCR,"");
										if(ocrText.trim() == "")
										{
											input.OCR_Status = "Failed";
											input.AI_Analysis = "OCR output is empty. Please check the uploaded image and try again.";
										}
										else
										{
											input.OCR_Status = "Processing";
											prompt = "You are a nutrition analysis assistant for a Personalized Diet Recommendation System. " + "Analyze the following text extracted from a food nutrition label. " + "Identify the food name, brand, serving size, calories, protein, carbohydrates, fat, fibre, sugar, sodium and ingredients if available. " + "Explain the nutritional value in simple language. " + "Mention possible allergens only when supported by the extracted text. " + "Do not invent missing nutritional values. Clearly mention any unreadable or missing information. " + "Do not provide medical diagnoses.\n\n" + "FOOD LABEL TEXT:\n" + ocrText;
											part = Map();
											part.put("text",prompt);
											parts = List();
											parts.add(part);
											content = Map();
											content.put("parts",parts);
											contents = List();
											contents.add(content);
											payload = Map();
											payload.put("contents",contents);
											response = invokeurl
											[
												url :"https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent"
												type :POST
												body:payload.toString()
												headers:{"Content-Type":"application/json"}
												detailed:true
												connection:"gemini_admin_connection"
											];
											responseMap = response.toMap();
											responseCode = responseMap.get("responseCode");
											if(responseCode == 200)
											{
												responseBody = responseMap.get("responseText");
												candidates = responseBody.get("candidates");
												if(candidates != null && candidates.size() > 0)
												{
													candidate = candidates.get(0);
													responseParts = candidate.get("content").get("parts");
													if(responseParts != null && responseParts.size() > 0)
													{
														analysisText = responseParts.get(0).get("text");
														input.AI_Analysis = analysisText;
														input.OCR_Status = "Completed";
													}
													else
													{
														input.OCR_Status = "Failed";
														input.AI_Analysis = "Gemini returned an empty analysis.";
													}
												}
												else
												{
													input.OCR_Status = "Failed";
													input.AI_Analysis = "Gemini returned no analysis.";
												}
											}
											else
											{
												input.OCR_Status = "Failed";
												input.AI_Analysis = "Gemini API error: " + response.toString();
											}
										}
						)
					}
				}

			}
		}

