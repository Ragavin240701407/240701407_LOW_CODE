				}
			}
		}
		form Meal_Plan_Details
		{
			displayname = "Meal Plan Details"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Meal_Plan
			(
				type = picklist	
				displayname = "Meal Plan"
				values  = Meal_Plans.ID
