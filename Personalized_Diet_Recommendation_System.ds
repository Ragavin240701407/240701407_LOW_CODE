		batchworkflow
		{
			Bulk_User_Diet_Reminder
			{
    			display name = "Bulk_User_Diet_Reminder"
    			type = batchworkflow
    			form = Users
    			event = "On Schedule"
    			start = "09-Nov-2026 17:51:43"
    			frequency = once
    			batch size = 1000
    			status = active
    			on execute 
    			{
					actions 
					{
						custom deluge script
						(
											if(input.Email != null && input.Email != "")
										{
											sendmail
											[
												from :zoho.adminuserid
												to :input.Email
												subject :"Weekly Diet Plan Reminder"
												message :"Hello " + input.User_Name + ",<br><br>" + "Please log in to your Personalized Diet Recommendation System " + "and review your personalized diet plan.<br><br>" + "Stay healthy!<br>" + "Diet Recommendation Team"
											]
										}
						)
					}
    			}
			}
		}

