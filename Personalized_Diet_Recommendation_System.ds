	 			row = 3
	 			column = 0   
				width = medium
			)
			Allergy_Information
			(
				type = section
				displayname = "Allergy Information"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Health_Conditions
			(
				type = section
				displayname = "Health Conditions"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Created_Date
			(
    			type = datetime
				displayname = "Created Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 5
	 			column = 1   
				width = medium
			)
			Has_Health_Conditions
			(
