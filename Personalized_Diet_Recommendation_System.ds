				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Pending Review","Approved","Rejected"}
			}
		}
		form Meals
		{
			success message = "Meal added successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Carbohydrates
			(
				type = decimal
				displayname = "Carbohydrates grams"
				decimalplace = 0
	 			row = 1
	 			column = 1   
				width = medium
			)
			Cuisine
			(
				type = picklist
				maxchar = 100
				values = {"Tamil Nadu","Chettinad","Kongunadu","South Indian","North Indian","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Recipe_Instructions
			(
    			type = textarea
				displayname = "Recipe Instructions"
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Meal_Management
			(
				type = section
				displayname = "Meal Management"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Meal_Name
			(
    			type = text
				displayname = "Meal Name"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Meal_Image
			(
    			type = image
				displayname = "Meal Image"
				source  = file
				aspect ratio = original
				camera = primary
	 			row = 2
	 			column = 1   
				width = medium
			)
			Main_Ingredients
			(
    			type = textarea
				displayname = "Main Ingredients"
				height = 13px
	 			row = 2
	 			column = 1   
				width = medium
			)
			must have Food_Type
			(
				type = picklist
				displayname = "Food Type"
				maxchar = 100
				values = {"Vegetarian","Non-Vegetarian","Vegan","Eggetarian"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Preparation_Method
			(
				type = picklist
				displayname = "Preparation Method"
				maxchar = 100
				values = {"Steamed","Boiled","Grilled","Roasted","Sautéed","Fried","Baked","Other"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Contains_Allergens
			(
				type = checkboxes	
				displayname = "Contains Allergens"
				values = {"Peanuts","Tree Nuts","Milk and Dairy","Eggs","Fish","Shellfish","Soy","Wheat / Gluten","Sesame","Coconut","Mustard","Other"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Availability_Status
			(
				type = picklist
				displayname = "Availability Status"
				maxchar = 100
				values = {"Available","Unavailable"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Nutritional_Info
			(
				type = section
				displayname = "Nutritional Information"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Meal_Description
			(
    			type = textarea
				displayname = "Meal Description"
				height = 13px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Calories
			(
				type = decimal
				displayname = "Calories kcal"
				decimalplace = 0
	 			row = 3
	 			column = 1   
				width = medium
			)
			Protein
			(
				type = decimal
				displayname = "Protein grams"
				decimalplace = 0
	 			row = 3
	 			column = 1   
				width = medium
			)
			Ingredients_Preparation
			(
				type = section
				displayname = "Ingredients and Preparation"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Additional_Notes
			(
    			type = textarea
				displayname = "Additional Notes"
				height = 13px
	 			row = 4
	 			column = 1   
				width = medium
			)
			Serving_Size
			(
				type = decimal
				displayname = "Serving Size grams"
				decimalplace = 0
	 			row = 4
	 			column = 1   
				width = medium
			)
			Fat
			(
				type = decimal
				displayname = "Fat grams"
				decimalplace = 0
	 			row = 4
	 			column = 1   
				width = medium
			)
			Fibre
			(
				type = decimal
				displayname = "Fibre grams"
				decimalplace = 0
	 			row = 4
	 			column = 1   
				width = medium
			)
			must have Meal_Category
			(
				type = picklist
				displayname = "Meal Category"
				maxchar = 100
				values = {"Breakfast","Lunch","Dinner","Evening Snack","Morning Snack"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			Created_Date
			(
    			type = datetime
				displayname = "Created Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 4
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Users
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Role
			(
				type = picklist
				maxchar = 100
				values = {"Admin","User"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			User_Name
			(
    			type = text
				displayname = "User Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
			)
			Date_of_Birth
			(
    			type = date
				displayname = "Date of Birth"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Phone_Number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Gender
			(
				type = picklist
				maxchar = 100
				values = {"Male","Female","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Activity_Level
			(
				type = picklist
				displayname = "Activity Level"
				maxchar = 100
				values = {"Sedentary","Lightly Active","Moderately Active","Very Active","Extremely Active"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Height
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Weight
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			BMI
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  if(ifnull(input.Height,0) > 0,input.Weight / (input.Height / 100.0).power(2),0)
    						visibility = false
    						format = plaintext
    			)
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		list Users_List
		{
			displayName = "Users List"
			show all rows from Users    
			(
				User_Name as "User Name"
				Email
				Phone_Number as "Phone Number"
				(
					displayformat = plainnumber 
				)
				Date_of_Birth as "Date of Birth"
				Gender
				Height
				Weight
				Activity_Level as "Activity Level"
				BMI
				Role
			)
			sort by
			(
				User_Name ascending
			)
		}
		default list All_Meal_Plans
		{
			displayName = "All Meal Plans"
			show all rows from Meal_Plans  [Plan_Status == "Pending Review"]  
			(
				Plan_Name as "Plan Name"
				User
				Plan_Description as "Plan Description"
				Plan_Type as "Plan Type"
				Fitness_Goal as "Fitness Goal"
				Start_Date as "Start Date"
				End_Date as "End Date"
				Plan_Duration_Days as "Plan Duration (Days)"
				Daily_Calorie_Target_kcal as "Daily Calorie Target (kcal)"
				Daily_Protein_Target_grams as "Daily Protein Target (grams)"
				Daily_Carbohydrate_Target_grams as "Daily Carbohydrate Target (grams)"
				Daily_Fat_Target_grams as "Daily Fat Target (grams)"
				Plan_Status as "Plan Status"
				Admin_Comments as "Admin Comments"
				Reviewed_By as "Reviewed By"
				Review_Date as "Review Date"
				Created_Date as "Created Date"
				Added_Time as "Added Time"
				ID
			)
			group by
			(
				Plan_Status ascending
			)
			sort by
			(
				Added_Time descending
			)
		}
		default list Meal_Plan_Details_Report
		{
			displayName = "Meal Plan Details Report"
			show all rows from Meal_Plan_Details    
			(
				Meal_Plan as "Meal Plan"
				Meals
				User
				Start_Date as "Start Date"
				End_Date as "End Date"
				Scheduled_Date as "Scheduled Date"
				Day_Number as "Day Number"
				Meal_Type as "Meal Type"
				Serving_Quantity as "Serving Quantity"
			)
		}
		list Dietary_Preferences_Report
		{
			displayName = "Dietary Preferences Report"
			show all rows from Dietary_Preferences    
			(
				Preferred_Staple_Foods as "Preferred Staple Foods"
				User
				Spice_Preference as "Spice Preference"
				Daily_Calorie_Goal as "Daily Calorie Goal"
				Preferred_Lunch_Foods as "Preferred Lunch Foods"
				Preferred_Breakfast_Foods as "Preferred Breakfast Foods"
				Preferred_Food_Style as "Preferred Food Style"
				Disliked_Foods as "Disliked Foods"
				Additional_Food_Preferences as "Additional Food Preferences"
				Diet_Type as "Diet Type"
				Non_Vegetarian_Food_Preferences as "Non-Vegetarian Food Preferences"
				Preferred_Meals_Per_Day as "Preferred Meals Per Day"
				Preferred_Dinner_Foods as "Preferred Dinner Foods"
				Created_Date as "Created Date"
				Dietary_Restrictions as "Dietary Restrictions"
			)
		}
		list Fitness_Goals_Report
		{
			displayName = "Fitness Goals Report"
			show all rows from Fitness_Goals    
			(
				User
				Preferred_Physical_Activities as "Preferred Physical Activities"
				Daily_Activity_Duration_Minutes as "Daily Activity Duration Minutes"
				Primary_Fitness_Goal as "Primary Fitness Goal"
				Motivation_Goal_Description as "Motivation Goal Description"
				Additional_Notes as "Additional Notes"
				Current_Fitness_Level as "Current Fitness Level"
				Target_Weight_kg as "Target Weight kg"
				Target_Achievement_Date as "Target Achievement Date"
				Created_Date as "Created Date"
			)
		}
		list Health_Profile_Report
		{
			displayName = "Health Profile Report"
			show all rows from Health_Profile    
			(
				User
				Allergen_Categories as "Allergen Categories"
				Specific_Allergens as "Specific Allergens"
				Reaction_Symptoms as "Reaction Symptoms"
				Allergy_Severity as "Allergy Severity"
				Additional_Notes as "Additional Notes"
				Diagnosis_Status as "Diagnosis Status"
				Has_Food_Allergies as "Has Food Allergies"
				Condition_Categories as "Condition Categories"
				Specific_Conditions as "Specific Conditions"
				Dietary_Considerations as "Dietary Considerations"
				Created_Date as "Created Date"
				Has_Health_Conditions as "Has Health Conditions"
			)
		}
		list Meals_Report
		{
			displayName = "Meals Report"
			show all rows from Meals    
			(
				Carbohydrates as "Carbohydrates grams"
				Cuisine
				Recipe_Instructions as "Recipe Instructions"
				Meal_Image as "Meal Image"
				Main_Ingredients as "Main Ingredients"
				Food_Type as "Food Type"
				Preparation_Method as "Preparation Method"
				Contains_Allergens as "Contains Allergens"
				Availability_Status as "Availability Status"
				Meal_Description as "Meal Description"
				Calories as "Calories kcal"
				Protein as "Protein grams"
				Additional_Notes as "Additional Notes"
