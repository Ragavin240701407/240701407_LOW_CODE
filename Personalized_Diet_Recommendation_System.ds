 application "Personalized Diet Recommendation System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Dietary_Preferences
		{
			title 
    		{
				displayname = "Dietary Preferences"
    			on add = "Add Dietary Preference"
   	 			on edit = "Edit Dietary Preference"
			}
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Preferred_Staple_Foods
			(
				type = checkboxes	
				displayname = "Preferred Staple Foods"
				values = {"White Rice","Brown Rice","Idli","Dosa","Chapati","Millet-based Foods","Ragi","Kambu (Pearl Millet)","Thinai (Foxtail Millet)","Varagu (Kodo Millet)"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have User
			(
				type = picklist	
				values  = Users.ID
    			displayformat = [User_Name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Spice_Preference
			(
				type = picklist
				displayname = "Spice Preference"
				maxchar = 100
				values = {"Mild","Medium","Spicy","Very Spicy"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Daily_Calorie_Goal
			(
				type = number
				displayname = "Daily Calorie Goal"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Preferred_Lunch_Foods
			(
				type = checkboxes	
				displayname = "Preferred Lunch Foods"
				values = {"Rice and Sambar","Rasam Rice","Curd Rice","Lemon Rice","Tamarind Rice","Variety Rice","Meals with Poriyal and Kootu","Millet Meals","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Preferred_Breakfast_Foods
			(
				type = checkboxes	
				displayname = "Preferred Breakfast Foods"
				values = {"Idli","Dosa","Pongal","Upma","Puttu","Idiyappam","Adai","Paniyaram","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Preferred_Food_Style
			(
				type = checkboxes	
				displayname = "Preferred Food Style"
				values = {"Tamil Nadu Home-style Food","Chettinad Cuisine","Kongunadu Cuisine","Madurai-style Food","Chennai-style Food","Kerala Cuisine","Andhra Cuisine","North Indian Cuisine","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Disliked_Foods
			(
    			type = textarea
				displayname = "Disliked Foods"
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Additional_Food_Preferences
			(
    			type = textarea
				displayname = "Additional Food Preferences"
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Diet_Type
			(
				type = picklist
				displayname = "Diet Type"
				maxchar = 100
				values = {"Vegetarian","Non-Vegetarian","Eggetarian","Vegan","Pescatarian"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Non_Vegetarian_Food_Preferences
			(
				type = checkboxes	
				displayname = "Non-Vegetarian Food Preferences"
				values = {"Chicken","Mutton","Fish","Prawn","Egg","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Diet_Type_and_Preferences
			(
				type = section
				displayname = "Diet Type and Preferences"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Preferred_Meals_Per_Day
			(
				type = picklist
				displayname = "Preferred Meals Per Day"
				maxchar = 100
				values = {"2","3","4","5","6"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Preferred_Dinner_Foods
			(
				type = checkboxes	
				displayname = "Preferred Dinner Foods"
				values = {"Idli","Dosa","Chapati","Idiyappam","Vegetable Upma","Millet-based Dishes","Other"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Additional_Preferences
			(
				type = section
				displayname = "Additional Preferences"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Created_Date
			(
    			type = datetime
				displayname = "Created Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Dietary_Restrictions
			(
    			type = textarea
				displayname = "Dietary Restrictions"
				height = 13px
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Fitness_Goals
		{
			displayname = "Fitness Goals"
			success message = "Fitness Goals added successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have User
			(
				type = picklist	
				values  = Users.ID
    			displayformat = [User_Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Preferred_Physical_Activities
			(
				type = checkboxes	
				displayname = "Preferred Physical Activities"
				values = {"Walking","Running","Jogging","Cycling","Swimming","Yoga","Gym Workout","Strength Training","Calisthenics","Sports","No Regular Activity","Other"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Daily_Activity_Duration_Minutes
			(
				type = number
				displayname = "Daily Activity Duration Minutes"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Primary_Fitness_Goal
			(
				type = picklist
				displayname = "Primary Fitness Goal"
				maxchar = 100
				values = {"Weight Loss","Weight Gain","Muscle Building","Fat Loss","Weight Maintenance","General Fitness","Improved Stamina","Improved Flexibility","Healthy Lifestyle"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Motivation_Goal_Description
			(
    			type = textarea
				displayname = "Motivation Goal Description"
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Additional_Notes
			(
    			type = textarea
				displayname = "Additional Notes"
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Goal_Preferences
			(
				type = section
				displayname = "Goal Preferences"
	 			row = 2
	 			column = 0   
				width = medium
			)
			Current_Fitness_Level
			(
				type = picklist
				displayname = "Current Fitness Level"
				maxchar = 100
				values = {"Beginner","Intermediate","Advanced"}
	 			row = 2
	 			column = 1   
				width = medium
			)
			Record_Information
			(
				type = section
				displayname = "Record Information"
	 			row = 3
	 			column = 0   
				width = medium
			)
			Fitness_Goals_Section
			(
				type = section
				displayname = "Fitness Goals"
	 			row = 4
	 			column = 0   
				width = medium
			)
			Target_Weight_kg
			(
				type = decimal
				displayname = "Target Weight kg"
	 			row = 4
	 			column = 1   
				width = medium
			)
			User_Info
			(
				type = section
				displayname = "User Information"
	 			row = 5
	 			column = 0   
				width = medium
			)
			Target_Achievement_Date
			(
    			type = date
				displayname = "Target Achievement Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 5
	 			column = 1   
				width = medium
			)
			Created_Date
			(
    			type = datetime
				displayname = "Created Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 5
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Food_Scanner
		{
			displayname = "Food Scanner"
			success message = "Food Scanner Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Food_Label_Image
			(
    			type = image
				displayname = "Food Label Image"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			OCR
			(
    			type = textarea
				height = 100px
				private = true
	 			row = 1
	 			column = 1   
				width = medium
						AI_Properties
						(
									fieldtype = OCR
									basefield = Food_Label_Image
						)
			)
			AI_Analysis
			(
    			type = textarea
				displayname = "AI Analysis"
				height = 100px
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			OCR_Status
			(
				type = picklist
				displayname = "OCR Status"
				maxchar = 100
				values = {"Pending","Processing","Completed","Failed"}
				private = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Failed","Completed","Pending","Processing"}
			}
		}
