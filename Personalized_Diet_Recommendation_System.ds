		blueprint
		{
    			Meal_Plans_Approval_Blueprint as "Meal Plan Approval Lifecycle"
    			{
        			type = Blueprint
        			form = Meal_Plans
        			start
        			{
            			start stage = "Pending Review"
        			}
        			stages
        			{
           			"Pending Review"
           			{
           			}
           			"Approved"
           			{
           			}
           			"Rejected"
           			{
           			}
        			}
        			transitions
        			{
    				approve_meal_plan as "Approve Meal Plan"
    				{
         				type = normal
         				from stage = "Pending Review"
         				to stage = "Approved"
         				before
         				{
            				transition owner
            				(
                				permissions = {"Administrator"}
                				userfields = {User}
             				)
         				}
         				after
         				{
							actions 
							{
								custom deluge script
								(
															// Fetch the current record being processed
														record = Meal_Plans[ID == input.ID];
														// Update Reviewed_By with the logged-in administrator's email
														if(zoho.adminuserid != null)
														{
															record.Reviewed_By=zoho.adminuserid;
														}
														// Update Review_Date with the current date and time
														record.Review_Date=zoho.currenttime;
														// Note: Admin_Comments is optional and will retain its existing value if not provided
								)
							}
         				}
  				}
    				reject_meal_plan as "Reject Meal Plan"
    				{
         				type = normal
         				from stage = "Pending Review"
         				to stage = "Rejected"
         				before
         				{
            				transition owner
            				(
                				permissions = {"Administrator"}
                				userfields = {User}
             				)
         				}
         				after
         				{
							actions 
							{
								custom deluge script
								(
															// Validate that Admin_Comments is provided
														if(input.Admin_Comments.isBlank())
														{
															info "Error: Admin_Comments is mandatory and cannot be empty.";
															// Optionally, you can disable the submit button or show an alert
															// alert "Admin Comments are required.";
														}
														else
														{
															// Fetch the current logged-in user's email
															adminEmail = zoho.loginuserid;
															// Get the current date and time
															currentDateTime = now;
															// Update the Reviewed_By field with the admin's email
															input.Reviewed_By = adminEmail;
															// Update the Review_Date field with the current date and time
															input.Review_Date = currentDateTime;
															// The Admin_Comments field is already populated from input
															// No explicit update needed as input values are automatically saved on form submission
															info "Review details updated successfully. Reviewed_By: " + input.Reviewed_By + ", Review_Date: " + input.Review_Date;
														}
								)
							}
         				}
  				}
        			}
    			}
    			Food_Scanner_Processing as "Food Scanner Processing"
    			{
        			type = Blueprint
        			form = Food_Scanner
        			start
        			{
            			start stage = "Pending"
        			}
        			stages
        			{
           			"Failed"
           			{
           			}
           			"Completed"
           			{
           			}
           			"Pending"
           			{
           			}
           			"Processing"
           			{
           			}
        			}
        			transitions
        			{
    				complete_analysis as "Complete Analysis"
    				{
         				type = normal
         				from stage = "Processing"
         				to stage = "Completed"
         				before
         				{
         				}
         				after
         				{
         				}
  				}
    				mark_failed as "Mark Failed"
